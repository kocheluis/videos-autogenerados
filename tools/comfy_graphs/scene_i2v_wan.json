{
  "unet": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "wan2.2_ti2v_5B_fp16.safetensors", "weight_dtype": "fp8_e4m3fn" }
  },
  "clip": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors", "type": "wan" }
  },
  "vae": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "wan2.2_vae.safetensors" }
  },
  "load_image": {
    "class_type": "LoadImage",
    "inputs": { "image": "keyframe.png" }
  },
  "pos": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "subtle gentle motion, slow camera push-in", "clip": ["clip", 0] }
  },
  "neg": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "static, still, blurry, distorted, text, watermark", "clip": ["clip", 0] }
  },
  "latent": {
    "class_type": "Wan22ImageToVideoLatent",
    "inputs": { "vae": ["vae", 0], "width": 704, "height": 1280, "length": 81, "batch_size": 1, "start_image": ["load_image", 0] }
  },
  "sampler": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["unet", 0], "seed": 12345, "steps": 30, "cfg": 5.0,
      "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0,
      "positive": ["pos", 0], "negative": ["neg", 0], "latent_image": ["latent", 0]
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["sampler", 0], "vae": ["vae", 0] }
  },
  "create": {
    "class_type": "CreateVideo",
    "inputs": { "images": ["decode", 0], "fps": 24.0 }
  },
  "save": {
    "class_type": "SaveVideo",
    "inputs": { "video": ["create", 0], "filename_prefix": "wan_i2v", "format": "mp4", "codec": "h264" }
  }
}
