{
  "unet": {
    "class_type": "UnetLoaderGGUF",
    "inputs": { "unet_name": "flux1-schnell-Q4_K_S.gguf" }
  },
  "clip": {
    "class_type": "DualCLIPLoader",
    "inputs": { "clip_name1": "t5xxl_fp8_e4m3fn.safetensors", "clip_name2": "clip_l.safetensors", "type": "flux" }
  },
  "vae": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "flux_ae.safetensors" }
  },
  "pos": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "a needle-felted wool doll character", "clip": ["clip", 0] }
  },
  "guidance": {
    "class_type": "FluxGuidance",
    "inputs": { "conditioning": ["pos", 0], "guidance": 3.5 }
  },
  "neg": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "", "clip": ["clip", 0] }
  },
  "latent": {
    "class_type": "EmptySD3LatentImage",
    "inputs": { "width": 832, "height": 1472, "batch_size": 1 }
  },
  "sampler": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["unet", 0], "seed": 1234567, "steps": 4, "cfg": 1.0,
      "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0,
      "positive": ["guidance", 0], "negative": ["neg", 0], "latent_image": ["latent", 0]
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["sampler", 0], "vae": ["vae", 0] }
  },
  "save": {
    "class_type": "SaveImage",
    "inputs": { "filename_prefix": "flux_keyframe", "images": ["decode", 0] }
  }
}
