# Plantilla de variables de entorno. Copia a `.env` (gitignored) y rellena.
# NUNCA pongas secretos reales aquí; este archivo SÍ se versiona.

# --- LLM (override opcional del modelo de Ollama para pruebas) ---
# VAUTOGEN_LLM_MODEL=llama3.2:latest

# --- Ollama / ComfyUI (si no usas los defaults de settings.yaml) ---
# OLLAMA_HOST=http://127.0.0.1:11434
# COMFYUI_HOST=http://127.0.0.1:8188

# --- YouTube Data API (OAuth) — Fase 3 ---
# Las credenciales OAuth van en credentials.json / token.json (gitignored).
# YOUTUBE_CLIENT_SECRETS=credentials.json

# --- Rutas de modelos/checkpoints (si están fuera de models_cache/) ---
# MODELS_DIR=models_cache
